    {
      "parameters": {
        "jsCode": "const sales = items.map(i => parseFloat(i.json.totalSales) || 0);\nconst today = sales[sales.length - 1];\nconst history = sales.slice(0, -1);\nconst avg = history.reduce((a,b) => a+b, 0) / history.length;\nconst stdDev = Math.sqrt(history.reduce((sum, v) => sum + Math.pow(v - avg, 2), 0) / history.length);\nconst deviation = stdDev > 0 ? (today - avg) / stdDev : 0;\nconst isAnomaly = Math.abs(deviation) > 2;\n\nreturn [{ json: {\n  todaySales: today,\n  averageSales: avg.toFixed(2),\n  deviation: deviation.toFixed(2),\n  isAnomaly,\n  direction: deviation > 0 ? 'ارتفاع' : 'انخفاض'\n} }];"
      },
